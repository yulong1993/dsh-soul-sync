{
  "name": "dsh-soul-sync",
  "version": "0.1.0",
  "description": "Cross-OS disaster recovery and first-person soul continuity for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-soul": "./bin/dsh-soul.js"
  },
  "engines": {
    "dsh": ">=0.1.0-0",
    "node": ">=22.15.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./compaction": "./lib/compaction-soul.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  }
}
